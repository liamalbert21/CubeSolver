{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "manual",
                "COM3"
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "Backend",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "4"
            },
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        }
    ]
}